<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Deliberately absent: android.permission.INTERNET.
        This app never needs to talk to the network — everything it reads
        and writes stays on the device. Absent by design, not oversight.

        Also deliberately absent: any AccessibilityService declaration.
        This app reads aggregate usage stats (Android's own official API),
        never raw input events.
    -->

    <!-- Special permission: user must grant this manually in Settings.
         Cannot be requested via a runtime dialog. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Normal runtime permission (Android 13+) — only used for the
         critical-battery impact notice. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:label="Halfwake"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Halfwake"
        xmlns:tools="http://schemas.android.com/tools">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.HalfwakeWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/halfwake_widget_info" />
        </receiver>

        <!-- ACTION_BATTERY_LOW / ACTION_BATTERY_OKAY are exempt from the
             implicit-broadcast restrictions Android added in Oreo, so a
             manifest-registered receiver still works without a foreground
             service keeping the app alive. -->
        <receiver
            android:name=".BatteryLowReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BATTERY_LOW" />
                <action android:name="android.intent.action.BATTERY_OKAY" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
